{
  "name": "meweviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente compacto multi-cuenta para MeWe",
  "author": "evilpixi",
  "license": "MIT",
  "homepage": "https://github.com/evilpixi/mewe-goonieviewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evilpixi/mewe-goonieviewer.git"
  },
  "bugs": {
    "url": "https://github.com/evilpixi/mewe-goonieviewer/issues"
  },
  "keywords": [
    "mewe",
    "electron",
    "desktop",
    "client",
    "multi-account"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "debug": "node scripts/start.js --mewe-debug",
    "emoji:update": "node scripts/build-emoji.js",
    "icons:update": "node scripts/build-icons.js",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.evilpixi.meweviewer",
    "productName": "Goonie Mewe Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Goonie-Mewe-Viewer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Goonie-Mewe-Viewer-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "identity": "-",
      "artifactName": "Goonie-Mewe-Viewer-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "executableName": "meweviewer",
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "emojibase-data": "^17.0.0",
    "lucide-static": "^1.52.0"
  }
}
